    "@radix-ui/react-progress": "^1.1.8",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.100.14",
    "@xyflow/react": "^12.11.0",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "elkjs": "^0.11.1",
    "i18next": "^26.3.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.30.4",
    "sonner": "^2.0.7",

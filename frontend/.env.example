# =============================================================================
# EchoMind frontend -- variabili d'ambiente (Vite)
#
# COME USARE
#   1. Copia in .env:  cp .env.example .env
#   2. Popola i valori (NON committare .env)
#
# IMPORTANTE: tutto cio' che ha prefisso VITE_ viene incluso nel bundle servito
# al browser. Metti qui SOLO valori pubblici (mai secret backend).
# =============================================================================

# Base URL dell'API backend (FastAPI). In dev: uvicorn locale.
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Supabase Auth (login lato client). La anon key e' PUBBLICA per design:
# serve al browser per autenticarsi; le policy RLS proteggono i dati.
# Source: dashboard.supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# EchoMind — Template variabili d'ambiente
#
# COME USARE QUESTO FILE
#   1. Copialo come .env nella root: `cp .env.example .env`
#   2. Popola i valori reali (NON committare .env)
#   3. Le variabili senza valore di default vanno OBBLIGATORIAMENTE configurate
#      prima di lavorare sulla milestone che le usa.
#
# CONVENZIONE
#   - Sezioni raggruppate per servizio
#   - Ogni variabile ha un commento che spiega:
#       (a) cosa rappresenta
#       (b) in quale milestone diventa obbligatoria
#       (c) dove ottenerla
# =============================================================================

# -----------------------------------------------------------------------------
# Ambiente applicativo (M1+)
# -----------------------------------------------------------------------------
# Valore: development | staging | production
APP_ENV=development
# Livello log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Postgres locale (M0 — usato da docker-compose.dev.yml)
# In produzione → sostituito da DATABASE_URL Supabase.
# -----------------------------------------------------------------------------
POSTGRES_USER=echomind
POSTGRES_PASSWORD=echomind_dev
POSTGRES_DB=echomind
POSTGRES_PORT=5432

# Connection string completa (M1+). asyncpg per SQLAlchemy async.
DATABASE_URL=postgresql+asyncpg://echomind:echomind_dev@localhost:5432/echomind

# -----------------------------------------------------------------------------
# RabbitMQ locale (M0)
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -----------------------------------------------------------------------------
# Redis locale (M0)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CLOUD SERVICES — popolare manualmente dall'utente
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — PostgreSQL managed + Auth (M1)
# Source: dashboard.supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret per validare token Supabase (M1)
# Source: dashboard.supabase.com → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Neo4j AuraDB — Knowledge Graph (M5)
# Source: console.neo4j.io → istanza creata
# Formato URI: neo4j+s://xxxxxxxx.databases.neo4j.io
# -----------------------------------------------------------------------------
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# Backblaze B2 — Object Storage S3-compatible (M2)
# Source: secure.backblaze.com → App Keys → Create New
# -----------------------------------------------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Endpoint S3-compatible (varia per regione, es. s3.eu-central-003.backblazeb2.com)
B2_ENDPOINT=
B2_REGION=eu-central-003

# -----------------------------------------------------------------------------
# OpenAI — Whisper (trascrizione) + LLM extraction (M4 + M5)
# Source: platform.openai.com/api-keys
# RACCOMANDATO: imposta un soft-limit di spesa nell'account.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=

# -----------------------------------------------------------------------------
# Anthropic — Claude (M5, alternativa a OpenAI per estrazione)
# Source: console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Sentry — error tracking (M9)
# -----------------------------------------------------------------------------
SENTRY_DSN=

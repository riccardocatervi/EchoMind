# =============================================================================
# EchoMind — Template variabili d'ambiente
#
# COME USARE QUESTO FILE
#   1. Copialo come .env nella root: `cp .env.example .env`
#   2. Popola i valori reali (NON committare .env)
#   3. Le variabili senza valore di default vanno OBBLIGATORIAMENTE configurate
#      prima di lavorare sulla milestone che le usa.
#
# CONVENZIONE
#   - Sezioni raggruppate per servizio
#   - Ogni variabile ha un commento che spiega:
#       (a) cosa rappresenta
#       (b) in quale milestone diventa obbligatoria
#       (c) dove ottenerla
# =============================================================================

# -----------------------------------------------------------------------------
# Ambiente applicativo (M1+)
# -----------------------------------------------------------------------------
# Valore: development | staging | production
APP_ENV=development
# Livello log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Postgres locale (M0 — usato da docker-compose.dev.yml)
# In produzione → sostituito da DATABASE_URL Supabase.
# -----------------------------------------------------------------------------
POSTGRES_USER=echomind
POSTGRES_PASSWORD=echomind_dev
POSTGRES_DB=echomind
POSTGRES_PORT=5432

# Connection string completa (M1+). asyncpg per SQLAlchemy async.
DATABASE_URL=postgresql+asyncpg://echomind:echomind_dev@localhost:5432/echomind

# -----------------------------------------------------------------------------
# RabbitMQ locale (M0)
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -----------------------------------------------------------------------------
# Redis locale (M0)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Async jobs tuning (M3). Default applicativi; override opzionale.
# Broker = RABBITMQ_URL, result backend = REDIS_URL (sezioni sopra).
# -----------------------------------------------------------------------------
# Tentativi prima dello stato terminale 'failed' (poi dead-letter queue).
TASK_MAX_RETRIES=3
# Base (secondi) del backoff esponenziale tra i retry.
TASK_RETRY_BACKOFF_SECONDS=2
# Soft time limit per task (secondi).
TASK_SOFT_TIME_LIMIT_SECONDS=300

# -----------------------------------------------------------------------------
# CORS / Frontend (M6)
# -----------------------------------------------------------------------------
# Origini del browser ammesse a chiamare l'API (la SPA React e' su host:porta
# diversi). Stringa CSV (oppure lista JSON). Default applicativo: il dev server
# Vite. In produzione: l'origin del frontend deployato, es. https://app.example.com
# Piu' origini: CORS_ALLOW_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173

# =============================================================================
# CLOUD SERVICES — popolare manualmente dall'utente
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — PostgreSQL managed + Auth (M1)
# Source: dashboard.supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# JWT signing — Supabase usa due algoritmi a seconda dell'età del progetto:
#   - HS256 (legacy, simmetrico): un solo secret condiviso
#   - ES256 (corrente nuovi progetti, asimmetrico): chiave privata su Supabase,
#     chiave pubblica ECDSA P-256 (PEM) per la verifica
# Scegli UNO dei due percorsi di sotto.
# -----------------------------------------------------------------------------

# HS256 | ES256
SUPABASE_JWT_ALGORITHM=HS256

# --- Se SUPABASE_JWT_ALGORITHM=HS256 ---
# Source: Supabase Dashboard → JWT Keys → Legacy HS256 → Reveal
SUPABASE_JWT_SECRET=

# --- Se SUPABASE_JWT_ALGORITHM=ES256 ---
# Source: Supabase Dashboard → JWT Keys → Current Key → "..." → Public Key
# Accetta DUE formati alternativi (python-jose supporta entrambi):
#
# 1) JWK (JSON Web Key), come mostrato dalla dashboard Supabase (default).
#    Stringa JSON su singola riga. Esempio (singolo oggetto):
#      SUPABASE_JWT_PUBLIC_KEY={"kty":"EC","crv":"P-256","alg":"ES256","x":"...","y":"...","key_ops":["verify"]}
#    Funziona anche con array `{"keys":[{...}]}` (formato JWKS).
#
# 2) PEM su singola riga con \n letterali invece dei newline reali:
#      SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----"
#
# Lasciare vuoto se algorithm=HS256.
SUPABASE_JWT_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Neo4j — Knowledge Graph (M5)
# In dev locale: il container neo4j di docker-compose (bolt://localhost:7687).
#   NEO4J_PASSWORD deve essere >= 8 caratteri (vincolo Neo4j 5) e coincide con
#   quella del container (NEO4J_AUTH). Il default sotto funziona out-of-the-box.
# In produzione: Neo4j AuraDB. Source: console.neo4j.io --> istanza creata.
#   URI formato neo4j+s://xxxxxxxx.databases.neo4j.io
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=echomind_dev
# Porte pubblicate dal container neo4j (dev).
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# -----------------------------------------------------------------------------
# Backblaze B2 — Object Storage S3-compatible (M2)
# Source: secure.backblaze.com → App Keys → Create New
#
# In dev locale: lasciare tutto vuoto (i test usano moto come mock S3).
# In produzione: tutte e 4 (B2_KEY_ID, B2_APPLICATION_KEY, B2_BUCKET_NAME,
# B2_ENDPOINT) sono OBBLIGATORIE — l'app non parte se mancano.
# -----------------------------------------------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Endpoint S3-compatible (varia per regione, es. s3.eu-central-003.backblazeb2.com)
B2_ENDPOINT=
B2_REGION=eu-central-003

# Upload limits (M2). Valori sotto sono i default applicativi; sovrascrivibili.
# MAX_UPLOAD_SIZE_BYTES: 50MB. Per file più grandi, considera multipart upload (futuro).
MAX_UPLOAD_SIZE_BYTES=52428800
# UPLOAD_PRESIGN_TTL_SECONDS: 15 min. Max accettato 3600 (1h).
UPLOAD_PRESIGN_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# OpenAI — Whisper (trascrizione audio, M4)
# Source: platform.openai.com/api-keys
# RACCOMANDATO: imposta un soft-limit di spesa nell'account.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Tuning trascrizione audio (M4). Valori sotto = default applicativi, sovrascrivibili.
# NB: il chunking audio (pydub) richiede ffmpeg installato a livello di sistema:
#   macOS: brew install ffmpeg   |   Ubuntu: apt install ffmpeg
# WHISPER_MODEL: modello OpenAI di trascrizione.
WHISPER_MODEL=whisper-1
# WHISPER_MAX_CHUNK_BYTES: soglia oltre cui l'audio viene spezzato in chunk prima
# di Whisper (sotto il limite hard di 25MB, con margine). Default 24MB.
WHISPER_MAX_CHUNK_BYTES=25165824
# TRANSCRIPTION_SOFT_TIME_LIMIT_SECONDS: soft limit del task di trascrizione (piu'
# alto del task generico: l'audio lungo richiede minuti). Default 1800 (30 min).
TRANSCRIPTION_SOFT_TIME_LIMIT_SECONDS=1800

# -----------------------------------------------------------------------------
# Gemini / Google AI Studio — Knowledge Extraction (M5)
# Provider LLM scelto per estrazione grafo, riassunto ed embeddings (free tier).
# Source: aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Modello per estrazione + riassunto. ID esatto da AI Studio (es. gemini-3-flash);
# 'gemini-flash-latest' segue l'ultimo Flash disponibile.
GEMINI_MODEL=gemini-flash-latest
# Modello per gli embeddings (dedup entita' + RAG futuro M8).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dimensione del vettore di embedding: DEVE combaciare con la migration (vector(768)).
EMBEDDING_DIMENSIONS=768

# Tuning estrazione (M5). Valori sotto = default applicativi, sovrascrivibili.
# Dimensione max (caratteri) di un chunk passato all'LLM e overlap tra chunk.
EXTRACTION_MAX_CHUNK_CHARS=12000
EXTRACTION_CHUNK_OVERLAP_CHARS=500
# Soglia coseno [0..1] oltre cui due entita' sono fuse nella dedup semantica.
ENTITY_DEDUP_SIMILARITY_THRESHOLD=0.85
# Soft limit del task di estrazione (secondi): molte call LLM richiedono minuti.
EXTRACTION_SOFT_TIME_LIMIT_SECONDS=1800

# -----------------------------------------------------------------------------
# Anthropic — Claude (M5, alternativa NON usata di default: il provider e' Gemini)
# Source: console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Sentry — error tracking (M9)
# -----------------------------------------------------------------------------
SENTRY_DSN=
